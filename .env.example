# Local development: runs PostgreSQL in a local file via PGlite.
GIFT_DATA_SOURCE=pglite
LOCAL_DATABASE_PATH=.data/made-for-them

# Hosted PostgreSQL: change GIFT_DATA_SOURCE to postgres and set a private URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ADMIN_DATABASE_URL=postgresql://EDITOR_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# For Supabase, use the session pooler for migrations; transaction pooler for serverless reads.
# Never prefix database credentials with NEXT_PUBLIC_.

# Generated privately by pnpm admin:setup. Required to enable owner sign-in.
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
# ADMIN_ORIGIN=https://your-app-domain.example
# Hosted servers only: separate runtime roles and a trusted ingress header.
# APP_DEPLOYMENT=production
# ADMIN_CLIENT_IP_HEADER=x-real-ip
# See docs/deployment-readiness.md before enabling public owner access.
